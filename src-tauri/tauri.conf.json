{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Gestão de Eventos Pro",
  "version": "1.0.2",
  "identifier": "com.gestaodeeventospro",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Gestão de Eventos Pro",
        "width": 1400,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGMERFNTNBNUQ2Mzk1MjAKUldRZ2xXTmRPdVVOVDRpVkw4Z1RQd1AyK1BEM2VHdndRaGlzSWxJYldZUFV0eFQ4VEZxWGoyUEoK",
      "endpoints": [
        "https://github.com/djalexsander/gestaodeeventospro/releases/latest/download/latest.json"
      ],
      "dialog": true
    }
  }
}
